# Firebase Client SDK Configuration
# Get these from your Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK Configuration (Server-side only)
# Get these from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Google AI (Gemini) API Key
# Get this from Google AI Studio: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY_SECONDARY=your_gemini_api_key_secondary_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# ImageBB API Key (for image uploads)
# Get this from https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Admin email (public – used for client-side admin checks)
NEXT_PUBLIC_ADMIN_EMAIL=tirthankardasgupta2004@gmail.com

# Admin credentials (server-side only – used by /api/admin/* routes)
# Set ADMIN_UID to the Firebase UID of the admin account, and/or
# set ADMIN_EMAIL to the admin's email address. At least one must be set.
ADMIN_UID=2wnVOKn2JuhExnxpXLfrBHSFwJo1
ADMIN_EMAIL=tirthankardasgupta2004@gmail.com

# Environment
NODE_ENV=development

# Stripe Payment Integration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from https://dashboard.stripe.com/products)
NEXT_PUBLIC_STRIPE_MEDIUM_PRICE_ID=price_medium_monthly_id
NEXT_PUBLIC_STRIPE_MEDIUM_ANNUAL_PRICE_ID=price_medium_annual_id
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_pro_monthly_id
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual_id
NEXT_PUBLIC_STRIPE_ULTRA_PRO_PRICE_ID=price_ultrapro_monthly_id
NEXT_PUBLIC_STRIPE_ULTRA_PRO_ANNUAL_PRICE_ID=price_ultrapro_annual_id

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000