rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read/write their own data
    match /users/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to submit to the feedback collection
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Allow admins to read all feedback
    // Note: This is a simplified rule. For production, you would typically
    // have a 'roles' collection to check if request.auth.uid is an admin.
    // For this demo, we are allowing any authenticated user to read all feedback.
    // THIS IS NOT SECURE FOR PRODUCTION.
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
    }

    // Allow admin to read all user data (for dashboard)
    // THIS IS NOT SECURE FOR PRODUCTION.
    match /users/{userId} {
      allow read: if request.auth != null;
    }
     match /users/{userId}/{subcollection}/{docId} {
      allow read: if request.auth != null;
    }
     match /users/{userId}/profile/data {
      allow read: if request.auth != null;
    }

  }
}
