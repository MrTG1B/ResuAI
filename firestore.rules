
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // IMPORTANT: Replace this placeholder with your actual Admin User ID from Firebase Auth.
      return request.auth != null && request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Feedback collection: Authenticated users can create, admin can read all.
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin(); // Rule for individual doc reads if needed
    }
    match /feedback/{docId=**} {
        allow list: if isAdmin(); // Rule for listing all feedback
    }

    // Users collection:
    // 1. A user can read and write to their own subcollections (profile, resumes, etc.)
    match /users/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. The Admin can read ALL documents and sub-documents within the users collection.
    match /users/{document=**} {
      allow get, list: if isAdmin();
    }
  }
}
