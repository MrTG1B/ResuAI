
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection.
    // Users can read and write to their own documents and subcollections.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Rules for the 'feedback' collection.
    // Any authenticated user can create (submit) feedback.
    // Only the admin should be able to read all feedback (handled by admin SDK/permissions).
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Prevent clients from reading/modifying feedback list
    }
  }
}
