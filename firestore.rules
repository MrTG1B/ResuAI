rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow user creation by any authenticated user for their own ID.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow a user to read and write to their own document.
      // Also allow any authenticated user to list users for the admin panel.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null;

      // Rules for the 'profile' subcollection
      match /profile/{profileId} {
        // A user can read/write their own profile.
        // Any authenticated user can read any profile for the admin dashboard.
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null;
      }
      
      // Rules for 'portfolios' and 'resumes' subcollections
      match /{subcollection}/{docId} {
        // A user can read/write their own subcollection documents.
        // Any authenticated user can read any subcollection document for the admin dashboard.
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null;
      }
    }
  }
}
