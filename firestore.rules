
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin rules: Admins can read user data and delete users
    function isAdmin() {
      return request.auth.token.email == 'admin@resuai.com';
    }

    match /users/{userId} {
      // Admins can read any user's main doc, and delete them.
      allow get, delete: if isAdmin();
      
      // Admins can list the users collection for the dashboard.
      allow list: if isAdmin();

      // Authenticated users can read and write their OWN user document.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users full access to their own subcollections (resumes, portfolios, profile)
      match /{subcollection}/{docId=**} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
