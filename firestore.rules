
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    // Replace with your actual admin UID from Firebase Console
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == request.auth.token.get('email', '');
      // For production, use: request.auth.uid == 'YOUR_ADMIN_UID_HERE'
      // Or implement custom claims with Firebase Admin SDK
    }
    
    // Helper function to validate data size (prevent abuse)
    function isValidSize() {
      return request.resource.size() < 1048576; // 1MB limit
    }
    
    // Default rule: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to read and write their own data under the /users/{userId} path
    // Allow admin to read all user data
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isValidSize();
    }
    
    // Admin settings - only admin can write, user can read their own
    match /users/{userId}/admin/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // Allow authenticated users to create feedback, anyone to read
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidSize();
      allow update, delete: if false; // Feedback cannot be updated or deleted
    }
    
    // Allow public read access to portfolios (public portfolios feature)
    // Only owner can write
    match /{path=**}/portfolios/{portfolioId} {
      allow get, list: if true;
      allow write: if isAuthenticated() && isValidSize();
    }
  }
}
