rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      // Check for null before accessing properties
      return request.auth != null && request.auth.token.email == 'admin@resuai.com';
    }

    // Rules for 'users' collection
    match /users/{userId} {
      // Admins can read and delete any user document.
      allow get, delete: if isAdmin();
      // Users can read and write their own top-level document.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // This rule applies to all subcollections (resumes, portfolios, profile)
      // It grants the user full control over documents within their own subcollections.
      match /{subcollection}/{docId=**} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Admins can list the users collection for the dashboard
    match /users {
        allow list: if isAdmin();
    }
  }
}
