rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolios can be read by anyone (for sharing)
    // but can only be created, updated, or deleted by the authenticated owner.
    match /portfolios/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Resume editor state can only be read or written by the authenticated owner.
    match /resumeEditorState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
