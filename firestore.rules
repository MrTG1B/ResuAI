
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read-only access to portfolios
    match /users/{userId}/portfolios/{portfolioId} {
      allow get: if true;
    }
    
    // Allow public read-only access to portfolio collections for listing (if needed, but safer to restrict)
    match /users/{userId}/portfolios {
       allow list: if false; // Keep this false to prevent listing all portfolios of a user
    }

    // Allow logged-in users to submit feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
  }
}
