
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads/writes to prevent unintended access
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Users can read/write their own subdocuments (profile, resumes, portfolios)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admins can list all users. The dashboard is client-side protected.
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // FEEDBACK
    // Any authenticated user can create feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
    
    // Admins can read all feedback. The dashboard is client-side protected.
    match /feedback/{feedbackId} {
        allow read: if request.auth != null;
    }
  }
}
