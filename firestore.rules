
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is the owner of the data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Lock down user data: only the authenticated owner can access their documents.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Admin access: The admin user can read any user's data.
    // Replace 'YOUR_ADMIN_UID_HERE' with the actual UID of your admin account.
    match /users/{userId}/{document=**} {
      allow get, list: if request.auth.uid == 'Q5xQ2E0S4hR1D3rA9N7pX2wO3Yf2'; 
    }

    // Feedback Collection Rules:
    // - Any authenticated user can create (submit) feedback.
    // - Only the admin can read feedback to protect user privacy.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth.uid == 'Q5xQ2E0S4hR1D3rA9N7pX2wO3Yf2';
    }
  }
}
