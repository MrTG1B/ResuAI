rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow users to create their own profile, but not read/write others' top-level doc.
      allow create: if isSignedIn();
      // Allow admin to list users, but not read their private top-level doc.
      allow list: if isSignedIn();
      // A user can read/update/delete their own document
      allow read, update, delete: if isOwner(userId);

      // Allow owner to manage their own subcollections (portfolios, resumes, profile)
      match /{subcollection}/{docId} {
        allow read, write, delete: if isOwner(userId);
      }
      
      // Allow any signed-in user (acting as admin) to read profile data for the dashboard
      match /profile/{docId} {
         allow get: if isSignedIn();
      }
    }
  }
}
