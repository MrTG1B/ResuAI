rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == '2wnVOKn2JuhExnxpXLfrBHSFwJo1' ||
        request.auth.token.email == 'tirthankardasgupta2004@gmail.com'
      );
    }
    
    // Helper function to validate data size (prevent abuse)
    function isValidSize() {
      return request.resource.size() < 1048576; // 1MB limit
    }
    
    // Default rule: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to read and write their own data under the /users/{userId} path
    // Allow admin to read all user data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isValidSize();
      
      // Allow admin to write admin settings
      allow update: if isAdmin();
      
      // Allow access to all subcollections
      match /{subcollection}/{document} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && isValidSize();
        
        // For nested subcollections
        match /{nestedDocument=**} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId) && isValidSize();
        }
      }
      
      // Subscription data: only readable by owner and admin, only writable server-side (admin)
      match /subscription/{document} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }
    
    // Allow authenticated users to create feedback, admin and anyone to read
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidSize();
      allow update, delete: if isAdmin(); // Only admin can update/delete
    }
    
    // Allow public read access to portfolios (public portfolios feature)
    // Only owner can write
    match /{path=**}/portfolios/{portfolioId} {
      allow get, list: if true;
      allow write: if isAuthenticated() && isValidSize();
    }
  }
}
