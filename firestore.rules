
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read and write to their own subcollections (profile, resumes, portfolios)
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anyone who is authenticated can submit feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }

    // The admin dashboard will use secure Genkit server flows to read user/feedback data,
    // so we don't need broad client-side read rules here. The flows themselves run with
    // service account credentials which bypass these rules. The dashboard route is protected
    // by client-side session logic.
  }
}
