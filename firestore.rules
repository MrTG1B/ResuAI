
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can create their own user document.
      allow create: if request.auth != null;

      // Only the owner of the user document can read or update it.
      allow read, update: if isOwner(userId);
      
      // Deleting a user document is a sensitive operation and should
      // ideally be handled by a backend service/cloud function.
      // For now, we will disallow it from the client.
      allow delete: if false;

      // Rules for the 'profile' subcollection
      match /profile/{profileId} {
        // The owner can perform all operations on their own profile.
        allow read, write: if isOwner(userId);
      }
      
      // Rules for the 'resumes' subcollection
      match /resumes/{resumeId} {
        // The owner can perform all operations on their own resumes.
        allow read, write: if isOwner(userId);
        
        // Explicitly allow the owner to delete their own resumes.
        allow delete: if isOwner(userId);
      }
      
      // Rules for the 'portfolios' subcollection
      match /portfolios/{portfolioId} {
         // The owner can perform all operations on their own portfolios.
        allow read, write: if isOwner(userId);

        // Explicitly allow the owner to delete their own portfolios.
        allow delete: if isOwner(userId);
      }
    }
  }
}
