rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@resuai.com';
    }

    // Default to denying all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      // Admins can list, get, and delete any user document
      allow list, get, delete: if isAdmin();
      
      // A user can create their own document, and can read/update it.
      // They cannot delete their own top-level document.
      allow create, get, update: if request.auth.uid == userId;

      // PROFILE SUBCOLLECTION
      // A user can fully manage their own profile data.
      match /profile/{docId} {
        allow read, write: if request.auth.uid == userId;
      }

      // RESUMES SUBCOLLECTION
      // A user can fully manage their own resumes.
      // This explicitly allows the delete operation.
      match /resumes/{resumeId} {
        allow get, list, create, update, delete: if request.auth.uid == userId;
      }

      // PORTFOLIOS SUBCOLLECTION
      // A user can fully manage their own portfolios.
      // This explicitly allows the delete operation.
      match /portfolios/{portfolioId} {
        allow get, list, create, update, delete: if request.auth.uid == userId;
      }
    }
  }
}
