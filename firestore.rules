
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAdmin() {
      // Hardcode your admin UID here for security
      return request.auth != null && request.auth.uid == 'tirthankardasgupta2004@gmail.com';
    }

    // User-specific data
    match /users/{userId} {
      // The user document itself can be read by its owner or admin
      allow read: if isOwner(userId) || isAdmin();
      
      // Profile subcollection: owner can read/write
      match /profile/data {
        allow read, write: if isOwner(userId);
      }
      
      // Resumes subcollection: owner has full access
      match /resumes/{resumeId} {
        allow read, write, create, delete: if isOwner(userId);
      }

      // Portfolios subcollection: owner has full access
      match /portfolios/{portfolioId} {
        allow read, write, create, delete: if isOwner(userId);
      }

      // Chats subcollection: owner has full access
      match /chats/{chatId} {
        allow read, write, create, delete: if isOwner(userId);
      }
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      // Any authenticated user can create feedback
      allow create: if request.auth != null;
      // Only admin can read or delete feedback
      allow read, delete: if isAdmin();
      // No one can update feedback after it's created
      allow update: if false;
    }
  }
}
