
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      // In a real app, this would check a custom claim, but for now we use a hardcoded email.
      return request.auth.token.email == 'admin@resuai.com';
    }

    // Default deny all access to the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Users can create and update their own user document
      allow read, write: if request.auth.uid == userId;
      
      // Admins can get and delete any user document
      allow get, delete: if isAdmin();

      // Rules for the 'profile' subcollection
      match /profile/{profileId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // Rules for the 'resumes' subcollection
      match /resumes/{resumeId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
      
      // Rules for the 'portfolios' subcollection
      match /portfolios/{portfolioId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
    }
    
    // Admins can list all users for the dashboard
    match /users/{userId} {
      allow list: if isAdmin();
    }
  }
}
