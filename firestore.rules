
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 Helper function to check if user is the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 🔐 Helper function to check if user is admin
    function isAdmin() {
      // IMPORTANT: Replace this with your actual Admin UID in a real project
      return request.auth != null && request.auth.uid == 'Q5xQ2E0S4hR1D3rA9N7pX2wO3Yf2';
    }

    // 👤 User data collections
    match /users/{userId} {
      // Profile data is readable and writable only by the owner or admin
      allow read, write: if isOwner(userId) || isAdmin();

      // Subcollections can only be accessed by the owner or admin
      match /profile/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /resumes/{resumeId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
      match /portfolios/{portfolioId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
      match /chats/{chatId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
      match /coverletters/{coverletterId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // 📝 Feedback collection
    match /feedback/{feedbackId} {
      // Any signed-in user can submit feedback
      allow create: if request.auth != null;

      // Only admin can read, update, delete feedback
      allow read, update, delete: if isAdmin();
    }
  }
}
