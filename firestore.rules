rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the 'users' collection
    match /users/{userId} {
      // Allow the user to read/write to their own user document, but not others.
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Rules for the 'resumes' subcollection
      match /resumes/{resumeId} {
        // Allow the owner of the resume to perform any action on it.
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'portfolios' subcollection
      match /portfolios/{portfolioId} {
        // Allow the owner of the portfolio to perform any action on it.
        // For future sharing features, 'read' could be made more public.
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
