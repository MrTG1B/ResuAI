
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin
    function isAdmin() {
      // IMPORTANT: Replace with the actual UID of your admin user from Firebase Authentication
      return request.auth.uid == 'YOUR_ADMIN_UID_HERE';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Specific users can only manage their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Admin can read all user data and subcollections
    match /users/{document=**} {
        allow get, list: if isAdmin();
    }
    
    // FEEDBACK
    // Any authenticated user can submit feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth.uid != null;
    }

    // Admin can read all feedback
    match /feedback/{document=**} {
      allow get, list: if isAdmin();
    }
  }
}
