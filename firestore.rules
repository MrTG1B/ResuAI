
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow users to access their own user document if needed in the future
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Portfolios subcollection
      // Can be read by anyone for sharing, but only managed by the owner.
      match /portfolios/{portfolioId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Legacy single portfolio documents - keep for backward compatibility or remove if migrated
    match /portfolios/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Resume editor state is private to the authenticated user
    match /resumeEditorState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
