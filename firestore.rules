rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the owner of a document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a user to read their own user document.
      // This is necessary for the subcollection delete rules to work.
      allow get: if isOwner(userId);
      
      // Allow a user to create and update their own profile data
      allow write: if isOwner(userId);

      // Rules for the 'resumes' subcollection
      match /resumes/{resumeId} {
        // A user can perform any action on their own resumes
        allow read, write, delete: if isOwner(userId);
      }

      // Rules for the 'portfolios' subcollection
      match /portfolios/{portfolioId} {
         // A user can perform any action on their own portfolios
        allow read, write, delete: if isOwner(userId);
      }
    }
  }
}
