rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow user to create their own document
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow user to read their own document
      allow get: if isAuthenticated() && request.auth.uid == userId;

      // Allow any authenticated user to list all user documents for the admin dashboard
      allow list: if isAuthenticated();
      
      // Allow user to update their own document
      allow update: if isAuthenticated() && request.auth.uid == userId;

      // Allow user to delete their own document (and admin to delete any)
      // A more robust system would check for an 'admin' role in custom claims
      allow delete: if isAuthenticated();

      // Rules for user subcollections
      match /{subcollection}/{docId} {
        // A user can read, write, and delete documents in their own subcollections
        allow read, write, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}
