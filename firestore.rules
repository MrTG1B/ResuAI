rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is the owner of the data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if the user is the designated admin
    function isAdmin() {
      // It's recommended to store admin UIDs in a separate collection in a real app,
      // but hardcoding is acceptable for this context.
      return request.auth != null && request.auth.uid == 'Q5xQ2E0S4hR1D3rA9N7pX2wO3Yf2';
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow a user to read their own main user document if it exists, or create it.
      // This rule is minimal as the main user document is not currently used.
      allow read, create: if isOwner(userId) || isAdmin();

      // Rule for the user's profile data
      match /profile/data {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Rule for the 'resumes' subcollection
      match /resumes/{resumeId} {
        allow read, write, create, delete: if isOwner(userId) || isAdmin();
      }

      // Rule for the 'portfolios' subcollection
      match /portfolios/{portfolioId} {
        allow read, write, create, delete: if isOwner(userId) || isAdmin();
      }
      
      // Rule for the 'chats' subcollection
      match /chats/{chatId} {
        allow read, write, create, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Rules for the 'feedback' collection
    match /feedback/{feedbackId} {
      // Any signed-in user can create (submit) feedback
      allow create: if request.auth != null;
      
      // Only the admin can read, update, or delete feedback entries
      allow read, update, delete: if isAdmin();
    }
  }
}
