rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@resuai.com';
    }

    // Deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow admins to list users for the dashboard
    match /users {
      allow list: if isAdmin();
    }

    // Rules for a specific user's document and subcollections
    match /users/{userId} {
      // Admin can get and delete any user document
      allow get, delete: if isAdmin();

      // Authenticated users can create, read, update, and delete their own top-level document
      allow create, get, update, delete: if request.auth != null && request.auth.uid == userId;

      // This rule allows users to perform any action on any document in any subcollection under their own user ID.
      // This covers /resumes, /portfolios, /profile, etc.
      match /{subcollection}/{docId=**} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
