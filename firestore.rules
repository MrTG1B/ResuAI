rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write to their own data.
    // This rule covers the profile subcollection and all other subcollections
    // like resumes, portfolios, coverletters, and chats.
    match /users/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Feedback can be created by any authenticated user, but they can't read
    // or modify any feedback after it's submitted.
    // The userId in the document must match the creator's uid.
    match /feedback/{feedbackId} {
      allow read, update, delete: if false; // No one can read/change feedback directly.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
