
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Admin-only access to root collections
    function isAdmin() {
      // IMPORTANT: Replace this placeholder with your actual Admin User ID from Firebase Authentication.
      // You can find this on the "Users" page of your Firebase console.
      return request.auth.uid == "YOUR_ADMIN_UID_HERE"; 
    }
  
    // Users can read/write their own data in subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Admin can read all user data (for dashboard)
    match /users/{userId} {
        allow read: if isAdmin();
    }
    
    // Any authenticated user can create feedback
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }
    
    // Admin can read all feedback
    match /feedback/{feedbackId} {
        allow read: if isAdmin();
    }
  }
}
