rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to read and write their own data, but not other users' data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to read from the 'portfolios' subcollection.
    // This is necessary for public portfolio pages to work.
    match /users/{userId}/portfolios/{portfolioId} {
        allow get: if true;
        allow list: if true;
        // Keep write access restricted to the owner
        allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow anyone to submit feedback.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      // Restrict reads and writes to admins or a specific role in a real app
      allow read, update, delete: if false; 
    }
  }
}
