rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@resuai.com';
    }

    // By default, deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can get and delete any user document, and list all users
      allow get, delete: if isAdmin();
      allow list: if isAdmin();
      
      // An authenticated user can read and write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Rules for subcollections (resumes, portfolios, profile)
      match /{subcollection}/{docId=**} {
        // An authenticated user has full access to their own subcollections
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
