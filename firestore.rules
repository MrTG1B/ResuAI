
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to read and write their own data under the /users/{userId} path
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read-only access to the 'feedback' collection
    match /feedback/{feedbackId} {
      allow read, create: if true;
    }
    
    // Allow public read access to all portfolios using a collection group query
    match /{path=**}/portfolios/{portfolioId} {
      allow get: if true;
      allow list: if true;
    }
  }
}
